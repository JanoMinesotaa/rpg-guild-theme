{% doc %}
  @prompt
    I just need a photo slider or photo carousel with a heading and some text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-photo-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-photo-carousel-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-photo-carousel-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 32px;
  }

  .ai-photo-carousel-heading-{{ ai_gen_id }} {
    font-family: "Rosarivo", serif !important;
    font-weight: 400 !important;
    color: #54130F !important;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: 0;
    margin: 0 0 16px 0;
  }

  .ai-photo-carousel-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-photo-carousel-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-photo-carousel-slider-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slide_gap }}px;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .ai-photo-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.slide_gap | times: 2 }}px) / {{ block.settings.slides_per_view }});
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-photo-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    object-fit: cover;
    display: block;
  }

  .ai-photo-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-photo-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-photo-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-photo-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }

  .ai-photo-carousel-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-photo-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-photo-carousel-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-photo-carousel-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-photo-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-photo-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-photo-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-photo-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - {{ block.settings.slide_gap }}px);
    }

    .ai-photo-carousel-heading-{{ ai_gen_id }} {
    font-size: 32px;
    }

    .ai-photo-carousel-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<photo-carousel-{{ ai_gen_id }} class="ai-photo-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-photo-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="ai-photo-carousel-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-photo-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="ai-photo-carousel-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-photo-carousel-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-photo-carousel-slider-{{ ai_gen_id }}" data-slider>
        {% for i in (1..8) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign image = block.settings[image_key] %}
          
          <div class="ai-photo-carousel-slide-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-photo-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                {% if i == 1 %}
                  <div class="ai-photo-carousel-empty-state-{{ ai_gen_id }}">
                    Add images to create your carousel
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_controls %}
      <div class="ai-photo-carousel-controls-{{ ai_gen_id }}">
        <button
          class="ai-photo-carousel-button-{{ ai_gen_id }}"
          data-prev
          aria-label="Previous slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-photo-carousel-dots-{{ ai_gen_id }}" data-dots></div>

        <button
          class="ai-photo-carousel-button-{{ ai_gen_id }}"
          data-next
          aria-label="Next slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</photo-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PhotoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = {{ block.settings.slides_per_view }};
        this.autoplay = {{ block.settings.autoplay }};
        this.autoplayDelay = {{ block.settings.autoplay_delay | times: 1000 }};
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.slider = this.querySelector('[data-slider]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.slides = this.slider.querySelectorAll('.ai-photo-carousel-slide-{{ ai_gen_id }}');
        
        this.updateSlidesPerView();
        this.createDots();
        this.updateSlider();
        this.setupEventListeners();
        
        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      updateSlidesPerView() {
        if (window.innerWidth <= 749) {
          this.currentSlidesPerView = 1;
        } else {
          this.currentSlidesPerView = this.slidesPerView;
        }
        this.totalSlides = Math.max(0, this.slides.length - this.currentSlidesPerView + 1);
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToPrev();
            this.stopAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToNext();
            this.stopAutoplay();
          });
        }

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.createDots();
          this.updateSlider();
        });

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.slider.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
          this.stopAutoplay();
        });

        this.slider.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.slider.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.goToNext();
            } else {
              this.goToPrev();
            }
          }
        });
      }

      createDots() {
        if (!this.dotsContainer) return;
        this.dotsContainer.innerHTML = '';
        
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-photo-carousel-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => {
            this.goToSlide(i);
            this.stopAutoplay();
          });
          this.dotsContainer.appendChild(dot);
        }
      }

      updateSlider() {
        const slideWidth = 100 / this.currentSlidesPerView;
        const offset = -(this.currentIndex * slideWidth);
        this.slider.style.transform = `translateX(${offset}%)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.totalSlides - 1;
        }

        const dots = this.dotsContainer?.querySelectorAll('.ai-photo-carousel-dot-{{ ai_gen_id }}');
        if (dots) {
          dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === this.currentIndex);
          });
        }
      }

      goToPrev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
        }
      }

      goToNext() {
        if (this.currentIndex < this.totalSlides - 1) {
          this.currentIndex++;
          this.updateSlider();
        } else if (this.autoplay) {
          this.currentIndex = 0;
          this.updateSlider();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
      }

      startAutoplay() {
        this.autoplayTimer = setInterval(() => {
          this.goToNext();
        }, this.autoplayDelay);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }
    }

    customElements.define('photo-carousel-{{ ai_gen_id }}', PhotoCarousel{{ ai_gen_id }});
  })();
</script>

