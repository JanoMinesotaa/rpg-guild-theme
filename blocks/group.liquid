{% if block.settings.width_mobile == "custom" %}
  {% assign width_mobile_value = block.settings.custom_width_mobile_value | default: "100" %}
  {% assign width_mobile_unit = block.settings.custom_width_mobile_unit | default: "%" %}
  {% assign final_width_mobile = width_mobile_value | append: width_mobile_unit %}
{% elsif block.settings.width_mobile == "fill" %}
  {% assign final_width_mobile = "100%" %}
{% else %}
  {% assign final_width_mobile = "fit-content" %}
{% endif %}

{% if block.settings.width == "custom" %}
  {% assign width_value = block.settings.custom_width_value | default: "100" %}
  {% assign width_unit = block.settings.custom_width_unit | default: "%" %}
  {% assign final_width = width_value | append: width_unit %}
{% elsif block.settings.width == "fill" %}
  {% assign final_width = "100%" %}
{% else %}
  {% assign final_width = "fit-content" %}
{% endif %}
<div
  class="group-wrapper group-wrapper-{{ block.id }} {{ block.settings.custom_class }}"
  style="
    padding: {{ block.settings.padding_top | default: 0 }}px {{ block.settings.padding_right | default: 0 }}px {{ block.settings.padding_bottom | default: 0 }}px {{ block.settings.padding_left | default: 0 }}px;
    margin: {{ block.settings.margin_top | default: 0 }}px {{ block.settings.margin_right | default: 0 }}px {{ block.settings.margin_bottom | default: 0 }}px {{ block.settings.margin_left | default: 0 }}px;
  "
>
<style>
  /* .group-wrapper-AaUpkbjY2KzRHM0R1d__group_rbcCmP {
    display: block;
  } */
  @media (min-width: 768px) {
    .group-wrapper-{{ block.id }} {
      width: {{ final_width }};
      display: flex;
      gap: {{ block.settings.gap | default: 0 }}px;
      flex-direction:
        {% if block.settings.content_direction == "row" %}
          row
        {% else %}
          column
        {% endif %} !important;
      justify-content:
        {% if block.settings.content_direction == "row" %}
          {{ block.settings.horizontal_alignment }}
        {% else %}
          {{ block.settings.horizontal_alignment_flex_direction_column }}
        {% endif %}  !important;
      align-items:
        {% if block.settings.content_direction == "row" %}
          {{ block.settings.vertical_alignment }}
        {% else %}
          {{ block.settings.vertical_alignment_flex_direction_column }}
        {% endif %}  !important;
    }
  }
@media (max-width: 767px) {
  .group-wrapper-{{ block.id }} .mobile-column {
    width: {{ final_width_mobile }};
    display: flex;
    gap: {{ block.settings.gap_mobile | default: 0 }}px;
    flex-direction:
      {% if block.settings.vertical_on_mobile %}
        column
      {% else %}
        row
      {% endif %};
    justify-content:
      {% if block.settings.vertical_on_mobile %}
        {{ block.settings.mobile_vertical_alignment_column }}
      {% else %}
        {{ block.settings.mobile_horizontal_alignment_row }}
      {% endif %};
    align-items:
      {% if block.settings.vertical_on_mobile %}
        {{ block.settings.mobile_horizontal_alignment_column }}
      {% else %}
        {{ block.settings.mobile_vertical_alignment_row }}
      {% endif %};
  }
}
</style>
{% if block.settings.enable_slider %}
  <div class="swiper">
    <div class="swiper-wrapper">
      {% for child in block.blocks %}
        <div class="swiper-slide">
          {% render child %}
        </div>
      {% endfor %}
    </div>
    <div class="slider-buttons-wrapper">
      <div class="swiper-button-prev"></div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
{% else %}
  {% capture children %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}
{% endif %}
</div>
