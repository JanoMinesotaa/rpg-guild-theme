{% stylesheet %}
.perfect-mini-picker {
  background: #F0E7D3;
  padding: 30px;
  border-radius: 12px;
  max-width: 420px;
}
.perfect-mini-picker-form label {
  font-weight: 600;
  margin-top: 12px;
  margin-bottom: 4px;
  display: block;
}
.perfect-mini-picker-form select,
.perfect-mini-picker-form button {
  width: 100%;
  padding: 10px 12px;
  border-radius: 6px;
  border: 1px solid #ccc;
  margin-bottom: 12px;
}
.radio-group {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}
.radio-group input {
  margin-right: 6px;
}
.perfect-mini-picker-form button {
  background: var(--color-button-primary, #54130F);
  color: #fff;
  font-weight: bold;
}
{% endstylesheet %}

