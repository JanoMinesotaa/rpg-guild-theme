                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>The official sheet is one layout for every class. This one is built for a single class, with room for the things that class actually tracks. The Artificer sheet, for instance, gives infusions their own section with space for the item each one is attached to.</p>",
                        "width": "100%",
