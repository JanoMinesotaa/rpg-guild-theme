                  "blocks": {
                    "text_e4U7Hd": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>The moment your order goes through. The sheet lands in your inbox as a PDF, so there is nothing to ship and nothing to wait for.</p>",
                        "width": "100%",
