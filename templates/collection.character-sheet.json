                "accordion_row_VWRqAi": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Can I fill it in on my computer, or do I have to print it?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_WaLE8F": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Either way. You can type straight into the PDF and keep it on your laptop or tablet, or print it and fill it in by hand at the table.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
