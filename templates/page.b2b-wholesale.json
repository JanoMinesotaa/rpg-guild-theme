                  },
                  "blocks": {
                    "text_htFPaN": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Our production farm manufactures up to 20,000 miniatures per month for wholesale partners, printed to order rather than held in stock.</p>",
