              "settings": {
                "custom_liquid": "<div class=\"custom-contact-wrapper-b2b\">\n  <iframe\n    id=\"JotFormIFrame-253104064722346\"\n    title=\"B2B form\"\n    allowtransparency=\"true\"\n    allow=\"geolocation; microphone; camera; fullscreen; payment\"\n    src=\"https://form.jotform.com/253104064722346\"\n    frameborder=\"0\"\n    style=\"width:100%;max-width:100%;border:none;overflow:hidden;\"\n    scrolling=\"no\"\n  ></iframe>\n\n  <script src=\"https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js\"></script>\n  <script>\n    window.jotformEmbedHandler(\n      \"iframe[id='JotFormIFrame-253104064722346']\",\n      \"https://form.jotform.com/\"\n    );\n\n    /* === AUTO HEIGHT SCRIPT === */\n    window.addEventListener(\"message\", function (e) {\n      if (\n        typeof e.data === \"object\" &&\n        e.data !== null &&\n        e.data.hasOwnProperty(\"iframeHeight\")\n      ) {\n        const iframe = document.getElementById(\"JotFormIFrame-253104064722346\");\n        if (iframe) {\n          iframe.style.height = e.data.iframeHeight + \"px\";\n        }\n      }\n    });\n  </script>\n</div>\n\n<style>\n  /* === DESKTOP default === */\n  .custom-contact-wrapper-b2b {\n    width: 100%;\n    margin: 0 auto;\n  }\n\n  /* === MOBILE: pełna szerokość === */\n  @media (max-width: 768px) {\n    .custom-contact-wrapper-b2b {\n      width: 100vw !important;\n      margin-left: calc(-50vw + 50%) !important;\n    }\n\n    #JotFormIFrame-253104064722346 {\n      width: 100vw !important;\n      max-width: 100vw !important;\n    }\n  }\n</style>"
