            "benefit_1_heading": "Over 1,000 Models in Catalogue",
            "benefit_1_text": "<p>Our printer farm allows us to deliver up to 5000+ figures per week with consistent, repeatable quality.</p>",
            "benefit_2_enabled": true,
            "benefit_2_icon": "none",
            "benefit_2_image_icon": "shopify://shop_images/2_7b325d9b-1934-4b5d-b5e8-1a53e103b019.png",
            "benefit_2_heading": "Retail-Ready Packaging",
            "benefit_2_text": "<p>Every mini ships in branded blister packaging with EAN barcode. Unbox, place on shelf, done.</p>",
            "benefit_3_enabled": true,
            "benefit_3_icon": "none",
            "benefit_3_image_icon": "shopify://shop_images/3_94795fd2-e201-4059-93b4-4411523811f7.png",
            "benefit_3_heading": "No Minimum Order Quantity",
            "benefit_3_text": "<p>Order 1 or 100 - no MOQ pressure. Test what sells before committing to bigger volumes.</p>",
            "benefit_4_enabled": true,
            "benefit_4_icon": "none",
            "benefit_4_image_icon": "shopify://shop_images/4_c3241102-9e6d-4ec5-9efb-45aabf08584b.png",
            "benefit_4_heading": "Fast Fulfilment",
            "benefit_4_text": "<p>Orders produced and shipped quickly. No waiting months for a container from overseas.</p>",
