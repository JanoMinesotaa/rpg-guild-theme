              "blocks": {
                "accordion_row_Cf4VQi": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What types of wholesale clients do you work with?",
                    "open_by_default": true
                  },
                  "blocks": {
                    "text_FGkNVt": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>We work with a wide range of partners including game stores, Kickstarter creators, miniature brands, board game publishers, terrain creators, and online sellers. Whether you need ongoing production or a one-time manufacturing partner, we can support your project</p>",
                        "width": "100%",
