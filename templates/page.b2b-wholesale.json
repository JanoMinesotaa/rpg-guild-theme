            "benefit_5_icon": "none",
            "benefit_5_image_icon": "shopify://shop_images/5_35d38bcb-d311-4fb6-9e90-424043eb083d.png",
            "benefit_5_heading": "Printed On Demand",
            "benefit_5_text": "<p>We only produce what's ordered. No dead stock sitting in your storage room.</p>",
            "benefit_6_enabled": true,
            "benefit_6_icon": "none",
            "benefit_6_image_icon": "shopify://shop_images/6_c356b9fa-8a1b-4f6e-8d49-44686ce87a47.png",
            "benefit_6_heading": "Proven Sellers",
            "benefit_6_text": "<p>Every model in our wholesale catalogue is already selling in our online store.</p>",
            "benefit_7_enabled": true,
            "benefit_7_icon": "none",
            "benefit_7_image_icon": "shopify://shop_images/7_ac204064-0ee4-4276-8d41-4832b98887d3.png",
            "benefit_7_heading": "Margins That Make Sense",
            "benefit_7_text": "<p>We sell to you at wholesale - you sell at retail. Built-in margin from day one. <strong>Example</strong>:<em> Buy at $5, sell at $12–15. That's a 3x+ margin, built in from day one.</em></p>",
            "benefit_8_enabled": true,
            "benefit_8_icon": "none",
            "benefit_8_image_icon": "shopify://shop_images/8_e0997ef8-fc2b-448f-bc6b-d2c0e229e316.png",
            "benefit_8_heading": "Free B2B Shipment",
            "benefit_8_text": "<p>Enjoy a free shipping offer to all orders that exceed 36 units.</p>",
            "benefit_9_enabled": true,
            "benefit_9_icon": "none",
            "benefit_9_image_icon": "shopify://shop_images/9_edb93381-cd26-4bbc-80ae-eaae0f2279cf.png",
