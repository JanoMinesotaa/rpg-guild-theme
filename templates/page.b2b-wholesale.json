                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Wholesale production runs take approximately 10-15 days, depending on project complexity and order size. Retail orders placed in our store are produced in 5-7 working days.</p>",
