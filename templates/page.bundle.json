                  "blocks": {
                    "text_zL48LD": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>It applies itself as you build. Five minis take 10% off, ten take 15%, and twenty take 30% - no code to enter, and the total updates with every mini you add.</p><p></p>",
