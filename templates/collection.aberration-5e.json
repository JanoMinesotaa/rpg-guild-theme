                "border_radius": 0,
                "padding-block-start": 24,
                "padding-block-end": 24,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "accordion_row_Wmt6Uw": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What scale should I pick if I want my miniature to fit a DnD grid perfectly?",
                    "open_by_default": true
                  },
                  "blocks": {
                    "text_rPR4xm": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>In most cases, the right choice is <strong>32mm scale</strong>. However, if you’d like to know the <em>exact</em> size of a specific miniature, simply reach out to us — we’ll gladly provide precise details. At times this may mean adjusting the original size to perfectly match your game, but that is no problem for the Guild. Your satisfaction is always our highest priority.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_rPR4xm"
                  ]
                },
                "accordion_row_JQXy6F": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "There is no scale option I want, what are my options?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_r3jqNc": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Feel free to message us about it! We will estimate if we can meet your needs. We've been printing miniatures in a <strong>variety of scale on demand!</strong></p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_r3jqNc"
                  ]
                },
                "accordion_row_nFa3fB": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "There's been an issue with my order, can you help?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_6xhij4": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Absolutely! Whether your order was delayed in shipment, a miniature arrived damaged, or a piece is missing - feel encouraged to contact us. We offer <strong>hassle-free refunds within 30 days</strong>, no questions asked. In most cases, it simply means sending you the missing part or replacing anything you’re not fully satisfied with.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_6xhij4"
                  ]
                },
                "accordion_row_eYkRHf": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "Can I request custom miniatures or other prints on demand?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_kkeeR4": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Yes! <strong>We just need a STL file to work with</strong>, which you can buy  from any online artist you like. For this case and any other, please message us first and we will take it from there.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_kkeeR4"
                  ]
                },
                "accordion_row_idfPGB": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "How long does production & preparation usually take?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_9FeaPp": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>We take our craft very seriously! Each miniature also goes through a hand-detailing process. <strong>It usually takes between 5 to 7 business days </strong>with the default, drybrush or primer option. Shipping time depends on your geolocation. You can <strong>get the estimated time</strong> on the top of each product page. Our full process is explained here.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_9FeaPp"
                  ]
                },
                "accordion_row_XgXGcJ": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "Is RPG Guild focused only on D2C, or do you also work with businesses?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_mJ43Jz": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p><strong>We are open to a variety of B2B opportunities and requests!</strong> If you're looking for a reliable partner visit our B2B page and contact us for more details :)</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
