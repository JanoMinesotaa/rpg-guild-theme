              "blocks": {
                "text_cpbVYi": {
                  "type": "text",
                  "settings": {
                    "enable_custom_font": false,
                    "custom_class": "title use-rosarivo",
                    "text": "<h2>Every Adventure Starts with a Miniature</h2>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "center",
                    "type_preset": "h3",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
