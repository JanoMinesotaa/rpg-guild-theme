                  },
                  "block_order": [
                    "text_ipGxyU"
                  ]
                },
                "accordion_row_FLmzGL": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "When do the dice ship?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_OEtfzj": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Dice come from stock, so there is no five to seven day print queue in front of them the way there is with our miniatures. If a set shows as available, it leaves with your order. If it shows as sold out, it is genuinely gone until the next pour. Delivery time then depends on where you are.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
