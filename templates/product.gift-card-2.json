            "custom_liquid_aQPD6N": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{% assign sculptor_name = product.metafields.custom.sculptor.value | default: product.metafields.custom.sculptor %}\n\n{% if sculptor_name %}\n  {%- comment -%} MAPA: nazwa z metapola → URL kolekcji {%- endcomment -%}\n  {% case sculptor_name %}\n    {% when \"Artisan Guild\" %}{% assign sculptor_url = \"/collections/artisan-guild-miniatures\" %}\n    {% when \"Cast n Play\" %}{% assign sculptor_url = \"/collections/cast-n-play-miniatures\" %}\n    {% when \"DM Stash\" %}{% assign sculptor_url = \"/collections/dm-stash-miniatures\" %}\n    {% when \"Rescale\" %}{% assign sculptor_url = \"/collections/rescale-miniatures\" %}\n    {% when \"Galaad\" %}{% assign sculptor_url = \"/collections/galaad-miniatures\" %}\n    {% when \"Daybreak\" %}{% assign sculptor_url = \"/collections/daybreak-miniatures\" %}\n    {% when \"Dungeon Dog\" %}{% assign sculptor_url = \"/collections/dungeon-dog\" %}\n  {% endcase %}\n\n  <p class=\"sculptor-line\">\n    <span class=\"label\">Designed by</span>\n    {% if sculptor_url %}\n      <a href=\"{{ sculptor_url }}\">{{ sculptor_name }}</a>\n    {% else %}\n      {{ sculptor_name }}\n    {% endif %}\n  </p>\n\n  <style>\n    .sculptor-line{margin:12px 0 4px}\n    .sculptor-line .label{opacity:.8;margin-right:.35em}\n    .sculptor-line a{font-weight:600;text-decoration:underline}\n  </style>\n{% endif %}"
              },
              "blocks": {}
            },
