          },
          "blocks": {
            "accordion_PBN7Cc": {
              "type": "accordion",
              "name": "t:names.accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "h4",
                "inherit_color_scheme": false,
                "color_scheme": "scheme-1",
                "border": "none",
