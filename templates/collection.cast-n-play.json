                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_MFtdgy"
                  ]
                },
                "accordion_row_X7ErTk": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "There's been an issue with my order, can you help?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_q66XgC": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Absolutely! Whether your order was delayed in shipment, a miniature arrived damaged, or a piece is missing - feel encouraged to contact us. We offer <strong>hassle-free refunds within 30 days</strong>, no questions asked. In most cases, it simply means sending you the missing part or replacing anything you’re not fully satisfied with.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_q66XgC"
                  ]
                },
                "accordion_row_CxEKqy": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "Can I request custom miniatures or other prints on demand?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_HTAGwz": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Yes! <strong>We just need a STL file to work with</strong>, which you can buy  from any online artist you like. For this case and any other, please message us first and we will take it from there.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_HTAGwz"
                  ]
                },
                "accordion_row_a47gBb": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "How long does production & preparation usually take?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_EJCLpe": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>We take our craft very seriously! Each miniature also goes through a hand-detailing process. <strong>It usually takes between 5 to 7 business days </strong>with the default, drybrush or primer option. Shipping time depends on your geolocation. You can <strong>get the estimated time</strong> on the top of each product page. Our full process is explained here.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_EJCLpe"
                  ]
                },
                "accordion_row_kNH9Qd": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_dash_row",
                  "settings": {
                    "heading": "Is RPG Guild focused only on D2C, or do you also work with businesses?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_yXarVr": {
                      "type": "text",
                      "name": "t:names.text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p><strong>We are open to a variety of B2B opportunities and requests!</strong> If you're looking for a reliable partner visit our B2B page and contact us for more details :)</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_yXarVr"
                  ]
                },
                "accordion_row_ltLuhx": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Why do your miniatures cost more than mass-produced ones?",
                    "open_by_default": false
                  },
                  "blocks": {
                    "text_SFAOML": {
                      "type": "text",
                      "settings": {
                        "enable_custom_font": false,
                        "custom_class": "c",
                        "text": "<p>Because nothing here is cast in advance. Every figure is printed on demand in resin and hand-detailed. That takes five to seven working days, and with weekends inside that window a parcel can leave the Guild on the tenth or eleventh day. Shipping from the EU comes on top. A mass-produced mini is cheaper because it was made before anyone wanted it. What you pay for here is the one character your player has been describing for a year.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "custom",
                        "font": "var(--font-subheading--family)",
                        "font_size": "1.25rem",
                        "line_height": "loose",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": false,
                        "background_color": "#00000026",
