            "custom_liquid_MrD844": {
              "type": "custom-liquid",
              "name": "Contact Form JotForm",
              "settings": {
                "custom_liquid": "{% liquid\n  assign current_language = request.locale.iso_code | downcase | split: '-' | first\n\n  case current_language\n    when 'de'\n      assign jotform_id = '261933772491364'\n      assign jotform_title = 'Kontaktformular'\n\n    when 'fr'\n      assign jotform_id = '261934125405352'\n      assign jotform_title = 'Formulaire de contact'\n\n    else\n      assign jotform_id = '253104736921353'\n      assign jotform_title = 'Contact Form'\n  endcase\n%}\n\n<div class=\"custom-contact-wrapper\">\n  <iframe\n    id=\"JotFormIFrame-{{ jotform_id }}\"\n    title=\"{{ jotform_title }}\"\n    allowtransparency=\"true\"\n    allow=\"geolocation; microphone; camera; fullscreen; payment\"\n    src=\"https://form.jotform.com/{{ jotform_id }}\"\n    frameborder=\"0\"\n    style=\"width:100%;max-width:100%;border:none;overflow:hidden;\"\n    scrolling=\"no\"\n  ></iframe>\n</div>\n\n<script src=\"https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js\"></script>\n\n<script>\n  window.jotformEmbedHandler(\n    \"iframe[id='JotFormIFrame-{{ jotform_id }}']\",\n    \"https://form.jotform.com/\"\n  );\n\n  window.addEventListener(\"message\", function (event) {\n    if (\n      typeof event.data === \"object\" &&\n      event.data !== null &&\n      Object.prototype.hasOwnProperty.call(event.data, \"iframeHeight\")\n    ) {\n      const iframe = document.getElementById(\n        \"JotFormIFrame-{{ jotform_id }}\"\n      );\n\n      if (iframe) {\n        iframe.style.height = event.data.iframeHeight + \"px\";\n      }\n    }\n  });\n</script>\n\n<style>\n  .custom-contact-wrapper {\n    width: 100%;\n    margin: 0 auto;\n  }\n\n  @media (max-width: 768px) {\n    .custom-contact-wrapper {\n      width: 100vw !important;\n      margin-left: calc(-50vw + 50%) !important;\n    }\n\n    #JotFormIFrame-{{ jotform_id }} {\n      width: 100vw !important;\n      max-width: 100vw !important;\n    }\n  }\n</style>"
              },
              "blocks": {}
            },
