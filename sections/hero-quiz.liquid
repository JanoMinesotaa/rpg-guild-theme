<section id="HeroQuiz-{{ section.id }}"
  class="hero-quiz-section color-{{ section.settings.color_scheme }}"
  style="
    --hero-min-height: {{ section.settings.section_height }};
    padding-block-start: {{ section.settings.padding_block_start }}px;
    padding-block-end: {{ section.settings.padding_block_end }}px;
  ">
  
  <div class="hero-quiz-container page-width">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'product_quiz' %}
          <div class="hero-quiz-block" {{ block.shopify_attributes }}>
            {% render 'hero-quiz-form', block: block, filters: collections.all.filters %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
.hero-quiz-section {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: var(--hero-min-height, 70vh);
}

.hero-quiz-container {
  max-width: 800px;
  width: 100%;
}

.hero-quiz-block {
  background: var(--color-background);
  padding: 2rem;
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Quiz",
  "tag": "section",
  "class": "hero-quiz-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "50vh", "label": "50% viewport" },
        { "value": "70vh", "label": "70% viewport" },
        { "value": "100vh", "label": "Full screen" }
      ],
      "default": "70vh"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product_quiz",
      "name": "Product Quiz",
      "settings": [
        {
          "type": "text",
          "id": "quiz_title",
          "label": "Quiz Title",
          "default": "Find Your Perfect Miniature!"
        },
        {
          "type": "text",
          "id": "submit_text",
          "label": "Submit Button Text",
          "default": "Search Miniature"
        },
        {
          "type": "text",
          "id": "quiz_results_page",
          "label": "Results Page Handle",
          "info": "Leave empty to use search results"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Quiz",
      "category": "Custom"
    }
  ]
}
{% endschema %}
