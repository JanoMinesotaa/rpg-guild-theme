{%- comment -%}
  Karuzela produktów z tej samej kolekcji, nad zdjęciem na karcie produktu.

  Karuzela chodzi krokiem, nie ciągiem. Co kilka sekund pasek przesuwa się
  płynnie o dokładnie jeden kafelek w lewo i z prawej strony wjeżdża kolejny
  produkt z tej samej kolekcji. Kafelek, który wyjechał za lewą krawędź, wraca
  na koniec rzędu, a pozycja przewinięcia jest w tym samym momencie pomniejszona
  o jego szerokość - przeskok jest więc niewidoczny, a pętla nie ma końca.

  Ruch robi scrollBy po tym samym pasku, który przewija palec, więc gest
  użytkownika i krok karuzeli nie walczą ze sobą: pasek jest zwykłym elementem
  przewijanym w poziomie (telefon i desktop).

  Szerokość kafelka i siatka bez zmian: pięć kafelków w kadrze, krawędź równa
  ze zdjęciem produktu.

  Wstawiać jako pierwszą sekcję szablonu produktu, nad "main".
{%- endcomment -%}

{%- comment -%}
  Kolekcja: pierwsza z adresem kończącym się na -5e (rasa albo typ potwora).
  Pierwsza kolekcja z brzegu bywa techniczna ("AVADA - Best Sellers",
  "Quick Order"). Bez kolekcji -5e sekcja się nie pokazuje.

  Polecenia Shopify (Search & Discovery): JS po załadowaniu strony pyta
  /recommendations/products o tę samą sekcję. Wtedy recommendations.performed
  jest true i plik zwraca same kafelki z polecanymi figurkami (typ produktu
  zawiera "Miniature"), a JS stawia je na początku paska.
{%- endcomment -%}
{% liquid
  assign col = section.settings.collection
  unless col
    for c in product.collections
      assign koncowka = c.handle | slice: -3, 3
      if koncowka == '-5e'
        assign col = c
        break
      endif
    endfor
  endunless

  assign limit = section.settings.max_products
  assign ile = 0
  assign zrodlo = col.products
  if recommendations.performed
    assign zrodlo = recommendations.products
  endif
%}

{%- capture kafelki -%}
  {%- for p in zrodlo limit: 40 -%}
    {%- if p.id == product.id -%}
      {%- continue -%}
    {%- endif -%}
    {%- if recommendations.performed -%}
      {%- unless p.type contains 'Miniature' -%}
        {%- continue -%}
      {%- endunless -%}
    {%- endif -%}
    {%- assign ile = ile | plus: 1 -%}
    {%- if ile > limit -%}
      {%- break -%}
    {%- endif -%}
    {%- comment -%}
      Wszystkie kafelki ładujemy zwykle, nie leniwie. W karuzeli każdy kafelek
      prędzej czy później wjeżdża w kadr, a leniwy dociąga się dopiero w tym
      momencie - czyli pokazuje się na chwilę jako puste pole. Wszystkie mają
      fetchpriority="low", więc nie konkurują ze zdjęciem produktu.
    {%- endcomment -%}
    <li class="sasiedzi__poz">
      <a class="sasiedzi__kafel" href="{{ p.url }}" aria-label="{{ p.title | escape }}" title="{{ p.title | escape }}">
        <span class="sasiedzi__fot">
          {%- if p.featured_media -%}
            {{
              p.featured_media
              | image_url: width: 260
              | image_tag: loading: 'eager', fetchpriority: 'low', widths: '130, 200, 260', alt: ''
            }}
          {%- endif -%}
        </span>
        <span class="sasiedzi__cena">{{ p.price_min | money }}</span>
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if recommendations.performed -%}
  <ul class="sasiedzi__lista" data-ile="{{ ile }}">{{ kafelki }}</ul>
{%- elsif col and ile > 0 -%}
  <div
    class="spacing-style sasiedzi-sekcja"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="sasiedzi">
      <p class="sasiedzi__tytul" data-polecane="{{ section.settings.heading_polecane | escape }}">
        {{- section.settings.heading_prefix }} {{ col.title -}}
      </p>
      <div
        class="sasiedzi__okno"
        id="Sasiedzi-{{ section.id }}"
        data-przerwa="{{ section.settings.interval }}"
        data-limit="{{ limit }}"
        data-polecane-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&section_id={{ section.id }}&limit=10&intent=related"
      >
        <ul class="sasiedzi__lista">{{ kafelki }}</ul>
      </div>

      {%- comment -%}
        Nawigacja pokazywana tylko na desktopie - na telefonie pasek przewija
        się palcem. Etykiety biorą się z tłumaczeń motywu, więc działają na
        rynkach DE i FR bez dokładania własnych kluczy, a ikona to ten sam
        caret, którego motyw używa w pozostałych karuzelach.
      {%- endcomment -%}
      <button
        type="button"
        class="sasiedzi__strzalka sasiedzi__strzalka--wstecz"
        data-kierunek="wstecz"
        aria-label="{{ 'accessibility.slideshow_previous' | t }}"
      >
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
      <button
        type="button"
        class="sasiedzi__strzalka sasiedzi__strzalka--wprzod"
        data-kierunek="wprzod"
        aria-label="{{ 'accessibility.slideshow_next' | t }}"
      >
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
    </div>
  </div>

  <script>
    (function () {
      var okno = document.getElementById('Sasiedzi-{{ section.id }}');
      if (!okno) return;

      var lista = okno.querySelector('.sasiedzi__lista');
      if (!lista) return;

      var korzen = okno.closest('.sasiedzi') || okno;
      var strzalki = korzen.querySelectorAll('.sasiedzi__strzalka');

      // Przy wyłączonych animacjach karuzela nie rusza sama i nie animuje
      // przesuwu, ale strzałki dalej działają - to ruch zamówiony klikiem.
      var bezRuchu = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var przerwa = (parseFloat(okno.dataset.przerwa) || 3) * 1000;
      var mysz = window.matchMedia('(hover: hover)');
      var ostatniGest = 0;
      var naszRuch = 0;
      var klatka = null;
      var timer;
      var cisza;
      var palec = false;

      // Po zatrzymaniu przewijania (i po puszczeniu palca) kadr wraca do
      // środkowej kopii rzędu - patrz wyrownaj().
      function poCiszy() {
        clearTimeout(cisza);
        cisza = setTimeout(function () {
          if (!klatka && !palec) wyrownaj();
        }, 150);
      }

      // Zdarzenie scroll leci i od palca, i od nas. Zapamiętujemy tylko gest
      // użytkownika - własny ruch karuzeli blokowałby inaczej kolejny krok.
      okno.addEventListener(
        'scroll',
        function () {
          if (Date.now() - naszRuch > 1200) ostatniGest = Date.now();
          poCiszy();
        },
        { passive: true }
      );
      okno.addEventListener('touchstart', function () { palec = true; }, { passive: true });
      ['touchend', 'touchcancel'].forEach(function (nazwa) {
        okno.addEventListener(nazwa, function () { palec = false; poCiszy(); }, { passive: true });
      });

      // Gest użytkownika przerywa przesuw w pół drogi - palec ma zawsze
      // pierwszeństwo przed karuzelą.
      ['pointerdown', 'touchstart', 'wheel'].forEach(function (nazwa) {
        okno.addEventListener(
          nazwa,
          function () {
            if (klatka) {
              cancelAnimationFrame(klatka);
              klatka = null;
            }
            ostatniGest = Date.now();
          },
          { passive: true }
        );
      });

      // Własny przesuw zamiast scrollBy z behavior: 'smooth'. Natywny trwa
      // ~300 ms i w tym tempie krok wygląda na szarpnięcie; tu mamy 650 ms
      // i tę samą krzywą, co reszta ruchu w sekcji.
      function przesun(dystans) {
        if (bezRuchu) {
          okno.scrollLeft += dystans;
          return;
        }
        var od = okno.scrollLeft;
        var poczatek = performance.now();
        var czas = 650;
        if (klatka) cancelAnimationFrame(klatka);
        var krok_ = function (teraz) {
          var x = Math.min(1, (teraz - poczatek) / czas);
          var e = x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
          naszRuch = Date.now();
          okno.scrollLeft = od + dystans * e;
          klatka = x < 1 ? requestAnimationFrame(krok_) : null;
        };
        klatka = requestAnimationFrame(krok_);
      }

      // Krok to odległość między początkami dwóch sąsiednich kafelków, czyli
      // szerokość kafelka plus odstęp. Mierzona z układu, żeby nie powtarzać
      // w JS wyliczenia, które siedzi w CSS.
      function krok() {
        var a = lista.children[0];
        var b = lista.children[1];
        if (!a || !b) return 0;
        return b.offsetLeft - a.offsetLeft;
      }

      // Palec przewija zwykły pasek, który ma koniec, a iPhone odbija go wtedy
      // w puste miejsce. Dlatego rząd dostaje kopie (ukryte dla czytników ekranu
      // i klawiatury) - po ok. 2500 px z każdej strony, czyli więcej niż jeden
      // mocny swipe - a kadr trzymamy w środkowej: kafelek przenoszony
      // z jednego końca rzędu na drugi zmienia pozycję przewinięcia o tyle samo,
      // więc kadr nie drga, przeskoku nie widać, a pętla nie ma końca.
      function powiel() {
        Array.prototype.forEach.call(lista.querySelectorAll('.sasiedzi__poz--kopia'), function (li) {
          li.remove();
        });
        var oryginaly = Array.prototype.slice.call(lista.children);
        if (okno.scrollWidth <= okno.clientWidth + 1) return;
        var pary = Math.max(1, Math.ceil(2500 / (krok() * oryginaly.length)));
        for (var i = 0; i < pary * 2; i++) {
          oryginaly.forEach(function (li) {
            var kopia = li.cloneNode(true);
            kopia.classList.add('sasiedzi__poz--kopia');
            kopia.setAttribute('aria-hidden', 'true');
            kopia.querySelectorAll('a').forEach(function (a) {
              a.tabIndex = -1;
            });
            lista.appendChild(kopia);
          });
        }
        okno.scrollLeft = krok() * oryginaly.length * pary;
      }

      function wyrownaj() {
        var d = krok();
        var n = lista.querySelectorAll('.sasiedzi__poz:not(.sasiedzi__poz--kopia)').length;
        if (!d || !n || !lista.querySelector('.sasiedzi__poz--kopia')) return;
        var okres = d * n;
        var srodek = Math.floor(lista.children.length / n / 2) * okres;

        var zabezpieczenie = lista.children.length;
        while (okno.scrollLeft > srodek + okres / 2 && zabezpieczenie-- > 0) {
          lista.appendChild(lista.firstElementChild);
          okno.scrollLeft -= d;
        }
        while (okno.scrollLeft < srodek - okres / 2 && zabezpieczenie-- > 0) {
          lista.insertBefore(lista.lastElementChild, lista.firstElementChild);
          okno.scrollLeft += d;
        }
      }

      function wprzod() {
        var d = krok();
        if (!d) return;
        wyrownaj();

        // Krok kończy się zawsze na krawędzi kafelka. Jeśli palec zostawił
        // pasek w pół kafelka, pierwszy krok po geście dociąga go do siatki -
        // inaczej ucięty kafelek zostawałby przy lewej krawędzi już na zawsze.
        var cel = (Math.floor((okno.scrollLeft + 0.5) / d) + 1) * d;
        naszRuch = Date.now();
        przesun(cel - okno.scrollLeft);
      }

      function wstecz() {
        var d = krok();
        if (!d) return;
        wyrownaj();

        var cel = (Math.ceil(okno.scrollLeft / d) - 1) * d;
        if (cel >= okno.scrollLeft - 0.5) cel -= d;

        naszRuch = Date.now();
        przesun(cel - okno.scrollLeft);
      }

      function tyk() {
        // Sekcja przeładowana w edytorze motywu - stary licznik gasi się sam.
        if (!document.contains(okno)) {
          clearInterval(timer);
          return;
        }
        if (document.hidden) return;
        if (mysz.matches && korzen.matches(':hover')) return;
        if (korzen.contains(document.activeElement)) return;
        if (Date.now() - ostatniGest < 1200) return;

        wprzod();
      }

      Array.prototype.forEach.call(strzalki, function (przycisk) {
        przycisk.addEventListener('click', function () {
          if (przycisk.dataset.kierunek === 'wstecz') wstecz();
          else wprzod();

          // Odliczanie startuje od nowa, żeby krok automatyczny nie dołożył się
          // zaraz po kliknięciu.
          if (timer) {
            clearInterval(timer);
            timer = setInterval(tyk, przerwa);
          }
        });
      });

      // Pasek mieści się w całości w kadrze - nie ma czym nawigować.
      function strzalkiWidoczne() {
        var widac = okno.scrollWidth > okno.clientWidth + 1;
        Array.prototype.forEach.call(strzalki, function (przycisk) {
          przycisk.style.display = widac ? '' : 'none';
        });
      }
      strzalkiWidoczne();
      powiel();

      // Polecenia Shopify. Gdy wróciły co najmniej 4 figurki, idą na początek
      // paska, a wolne miejsca do limitu dopełnia kolekcja (bez powtórek).
      // Mniej poleceń albo błąd - pasek zostaje z samą kolekcją.
      fetch(okno.dataset.polecaneUrl)
        .then(function (odp) {
          return odp.ok ? odp.text() : '';
        })
        .then(function (html) {
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var polecane = tmp.querySelectorAll('.sasiedzi__poz');
          if (polecane.length < 4) return;

          var limit = parseInt(okno.dataset.limit, 10) || 12;
          var byly = {};
          var nowa = document.createDocumentFragment();
          var dodaj = function (li) {
            var a = li.querySelector('a');
            if (!a || byly[a.pathname] || nowa.childNodes.length >= limit) return;
            byly[a.pathname] = true;
            nowa.appendChild(li);
          };
          Array.prototype.forEach.call(polecane, dodaj);
          Array.prototype.forEach.call(lista.querySelectorAll('.sasiedzi__poz:not(.sasiedzi__poz--kopia)'), dodaj);

          lista.replaceChildren(nowa);
          var tytul = korzen.querySelector('.sasiedzi__tytul');
          if (tytul && tytul.dataset.polecane) tytul.textContent = tytul.dataset.polecane;
          strzalkiWidoczne();
          powiel();
        })
        .catch(function () {});

      if (!bezRuchu) timer = setInterval(tyk, przerwa);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* Nie używam klasy section--page-width, bo base.css ma na nią globalne
     grid-template-columns: 1fr !important, a szerokość kontenera hero jest tam
     wpisana twardo pod konkretne ID sekcji. Powtarzam więc te same wymiary
     u siebie: 1540 max, 40 px na boki - to daje tę samą krawędź co zdjęcie. */
  .sasiedzi-sekcja {
    max-width: 1540px;
    margin-inline: auto;
    padding-inline: 40px;
  }

  /* Kolumna zdjęcia to połowa szerokości hero (siatka 680 + 680), ale samo
     zdjęcie jest o 24 px węższe - tyle wynosi padding-inline-end kolumny media,
     czyli połowa odstępu 48 px ustawionego w sekcji product-information.
     Odejmujemy go, żeby karuzela kończyła się równo ze zdjęciem. */
  .sasiedzi {
    max-width: calc(50% - 24px);
    min-width: 0;
  }

  @media screen and (width < 750px) {
    .sasiedzi-sekcja {
      padding-inline: 20px;
    }

    .sasiedzi {
      max-width: none;
    }
  }

  .sasiedzi__tytul {
    margin: 0 0 6px;
    font-size: 13px;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background));
  }

  /* Pasek pojawia się chwilę po wejściu na stronę, już z wczytanymi kafelkami.
     Bez tego widać było, jak obrazki wskakują jeden po drugim w ruchu. */
  .sasiedzi {
    opacity: 0;
    animation: sasiedzi-wejscie 420ms cubic-bezier(0.16, 1, 0.3, 1) 450ms forwards;
  }

  @keyframes sasiedzi-wejscie {
    to {
      opacity: 1;
    }
  }

  /* Pasek przewija się w bok: palcem na telefonie, gestem w bok albo
     shift+kółkiem na desktopie. Paska przewijania nie pokazujemy - na Windowsie
     zabrałby ~15 px wysokości, a od wysokości tego paska zależy wyrównanie
     prawej kolumny karty produktu (wyliczenie niżej). Że pasek idzie dalej,
     podpowiada maska wyciemniająca krawędzie.

     container-type pozwala liczyć szerokość kafelka od szerokości okna,
     a nie od listy, która jest celowo szersza niż ekran. */
  .sasiedzi__okno {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    container-type: inline-size;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
  }

  .sasiedzi__okno::-webkit-scrollbar {
    display: none;
  }

  /* Zawsze dokładnie pięć kafelków w kadrze: 5 * kafelek + 4 * 8 px odstępu = 100%.
     Szerokość w jednej zmiennej, bo JS liczy z niej krok karuzeli. */
  .sasiedzi__lista {
    --kafel: calc((100cqw - 32px) / 5);
    display: flex;
    width: max-content;
    gap: 8px;
    margin: 0;
    padding: 0 8px 0 0;
    list-style: none;
  }

  .sasiedzi__poz {
    flex: 0 0 var(--kafel);
  }

  /* Nawigacja: tylko desktop, bo na telefonie pasek przewija się palcem.
     Siedzi na krawędziach paska, w pionie na środku zdjęcia: .sasiedzi to
     etykieta plus pasek, więc 50% wysokości wypada 0,4 px od środka kafelka
     przy każdej szerokości ekranu. Przyciski są poza układem (position:
     absolute), więc nie zmieniają wysokości sekcji - wyliczenie, które
     wyrównuje prawą kolumnę karty produktu, zostaje nietknięte. */
  .sasiedzi {
    position: relative;
  }

  .sasiedzi__strzalka {
    display: none;
  }

  @media screen and (width >= 750px) {
    /* Kolory wprost takie, jak przycisk wariantu na tej karcie produktu:
       base.css ustawia tam #5D1309 na tle i #F1E4D9 na napisie, oba z
       !important. Zmienna motywu --color-primary-button-background to #54130F,
       czyli inny odcień czerwieni, więc trzymamy ten sam duet co przyciski
       obok - inaczej strzałki odstawałyby kolorem od reszty karty.
       Grubsza kreska ikony, bo caret motywu przy tej wielkości jest cienki. */
    .sasiedzi__strzalka {
      --icon-stroke-width: 2px;

      position: absolute;
      inset-block-start: 50%;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #5d1309;
      color: #f1e4d9;
      box-shadow: 0 2px 8px -3px rgb(0 0 0 / 40%);
      translate: 0 -50%;
      cursor: pointer;
      transition: background-color 260ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sasiedzi__strzalka:hover {
      background: color-mix(in srgb, #5d1309 86%, #f1e4d9);
    }

    .sasiedzi__strzalka svg {
      width: 16px;
      height: 16px;
    }

    /* Motyw ma caret skierowany w dół - obracamy go na boki. */
    .sasiedzi__strzalka--wstecz {
      inset-inline-start: 0;
    }

    .sasiedzi__strzalka--wstecz svg {
      rotate: 90deg;
    }

    .sasiedzi__strzalka--wprzod {
      inset-inline-end: 0;
    }

    .sasiedzi__strzalka--wprzod svg {
      rotate: -90deg;
    }
  }

  .sasiedzi__kafel {
    display: grid;
    gap: 5px;
    justify-items: center;
    text-decoration: none;
  }

  .sasiedzi__fot {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 420ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sasiedzi__fot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sasiedzi__kafel:hover .sasiedzi__fot {
    border-color: var(--color-primary);
    box-shadow: 0 8px 18px -10px color-mix(in srgb, var(--color-primary) 60%, transparent);
  }

  .sasiedzi__kafel:hover .sasiedzi__fot img {
    transform: scale(1.07);
  }

  .sasiedzi__cena {
    font-size: 12px;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background));
  }

  /* Bez ruchu: karuzela nie rusza (JS sam się nie uruchamia), pasek bez maski
     i bez pojawiania się, kafelki w stałych 76 px - zostaje zwykły rząd
     do przewinięcia palcem. */
  @media (prefers-reduced-motion: reduce) {
    .sasiedzi__okno {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .sasiedzi__lista {
      --kafel: 76px;
    }

    .sasiedzi {
      opacity: 1;
      animation: none;
    }
  }

  /* Okruszki renderuje layout, nie sekcja, więc stroimy je tylko na stronach,
     na których ta sekcja faktycznie jest. Domyślnie wiszą po prawej w węższym
     kontenerze niż treść i trzymają 16 px odstępu u góry i u dołu - przez to
     na karcie produktu wyglądają, jakby należały do czegoś innego.
     Tu: do lewej, w tej samej siatce co karuzela i zdjęcie, i ciaśniej. */
  body:has(.sasiedzi-sekcja) .breadcrumbs {
    justify-content: flex-start;
    padding: 4px 40px 10px;
    text-align: left;
  }

  /* Odstęp nad zdjęciem należy do wrappera sekcji hero i jest tam ustawiony
     z !important (.shopify-section[id$="__main"]:has(.product-information)).
     Przy karuzeli ten odstęp lądował POD nią zamiast pod okruszkami i robił
     80 px pustki. Przenosimy go nad pasek: sekcja hero dostaje wąski odstęp,
     a oddech daje padding-block-start samej karuzeli (ustawienie w schemacie).
     Selektor musi być bardziej szczegółowy od tamtej reguły, stąd !important. */
  .shopify-section:has(> .sasiedzi-sekcja) + .shopify-section[id$='__main'] {
    padding-block-start: 14px !important;
  }

  /* Prawa kolumna podnosi się o wysokość paska, żeby ocena i tytuł zaczynały
     się na tej samej wysokości co karuzela po lewej. Tylko desktop.

     Wysokość paska liczona, nie wpisana na sztywno: 70 px to stałe części
     (odstępy sekcji 16 + 14, etykieta 17 + 6, cena 12 + 5), a kafelek to
     (szerokość paska - 4 odstępy) / 5. Szerokość paska to szerokość kolumny
     zakupowej minus 24 px, stąd (100% - 56px) / 5 - procent w marginesie
     liczy się od szerokości kolumny. */
  @media screen and (width >= 750px) {
    .shopify-section:has(> .sasiedzi-sekcja) + .shopify-section[id$='__main'] .product-details {
      margin-block-start: calc(-1 * (70px + (100% - 56px) / 5));
    }

    /* Po podniesieniu prawa kolumna kończy się 48 px wyżej niż miniatury
       galerii po lewej. Rozkładamy te 48 px po równo na osiem przerw między
       blokami kolumny zakupowej: 24 px + 6 px = 30 px. Dolne krawędzie obu
       kolumn siadają równo, a odstępy rosną delikatnie i równomiernie.

       Uwaga: 6 px jest dobrane do tego produktu. Przy produkcie z inną liczbą
       wariantów luz będzie inny, więc przy rozszerzaniu na kolejne szablony
       trzeba to policzyć od nowa albo rozdzielać luz automatycznie.

       Selektor celuje wyłącznie w kontener najwyższego poziomu. Szerszy
       `.group-block-content` łapie też kontenery zagnieżdżone w blokach
       i odstęp rośnie dwa razy - sprawdzone, dawało 96 px zamiast 48. */
    .shopify-section:has(> .sasiedzi-sekcja) + .shopify-section[id$='__main']
      .product-details > .group-block > .group-block-content {
      row-gap: 30px;
    }
  }

  @media screen and (width < 750px) {
    body:has(.sasiedzi-sekcja) .breadcrumbs {
      padding: 4px 20px 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sąsiedzi z kolekcji",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekcja",
      "info": "Puste = pierwsza kolekcja produktu z adresem kończącym się na -5e."
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Słowo przed nazwą kolekcji",
      "default": "More"
    },
    {
      "type": "text",
      "id": "heading_polecane",
      "label": "Nagłówek, gdy pasek pokazuje polecenia Shopify",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Ile produktów",
      "min": 6,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Co ile sekund przesuwa się o kafelek",
      "unit": "s",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Odstęp u góry",
      "unit": "px",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Odstęp u dołu",
      "unit": "px",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 14
    }
  ],
  "presets": [{ "name": "Sąsiedzi z kolekcji" }]
}
{% endschema %}
