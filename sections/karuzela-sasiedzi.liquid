{%- comment -%}
  Karuzela produktów z tej samej kolekcji, nad zdjęciem na karcie produktu.

  Pasek sam nie jeździ. Stoi i przewija się w bok palcem (telefon) albo gestem
  i shift+kółkiem (desktop). Ruch to jedna podmiana: co kilka sekund jeden
  kafelek będący w kadrze przechodzi płynnie w inny produkt z tej samej
  kolekcji. Produkt na wejście bierze się z zapasu - kafelki w tym samym <ul>,
  oznaczone klasą --zapas, wyjęte z układu i schowane przez visibility, z już
  wczytanym obrazkiem, więc podmiana nigdy nie pokazuje pustego pola. Gdy
  kolekcja nie ma więcej produktów, niż pasek już pokazuje, zapas jest pusty
  i podmiana zamienia miejscami kafelek z kadru z kafelkiem spoza kadru.

  Szerokość kafelka, siatka i wysokość paska bez zmian wobec wersji karuzelowej:
  pięć kafelków w kadrze, krawędź równa ze zdjęciem produktu.

  Wstawiać jako pierwszą sekcję szablonu produktu, nad "main".
{%- endcomment -%}

{% liquid
  assign col = section.settings.collection
  unless col
    assign col = product.collections.first
  endunless

  assign limit = section.settings.max_products

  comment
    Zapas to kafelki poza rzędem, gotowe do wejścia na pasek. Sześć sztuk
    wystarcza: kafelek zdjęty z paska wraca na koniec kolejki, więc pula krąży
    i ten sam produkt wraca najwcześniej po szóstej podmianie. Koszt to sześć
    obrazków po ~11,5 KB w 260 px, czyli ~69 KB ponad to, co pasek ładował
    wcześniej.
  endcomment
  assign zapas_ile = 6
  assign pelna = limit | plus: zapas_ile
  assign ile = 0
%}

{%- capture kafelki -%}
  {%- for p in col.products limit: 40 -%}
    {%- if p.id == product.id -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign ile = ile | plus: 1 -%}
    {%- if ile > pelna -%}
      {%- break -%}
    {%- endif -%}
    {%- comment -%}
      Wszystkie kafelki ładujemy zwykle, nie leniwie - także te z zapasu.
      Leniwy obrazek dociąga się dopiero przy wjeździe w kadr, czyli pokazałby
      się na chwilę jako puste pole dokładnie w momencie podmiany. Wszystkie
      mają fetchpriority="low", więc nie konkurują ze zdjęciem produktu.
    {%- endcomment -%}
    <li class="sasiedzi__poz{% if ile > limit %} sasiedzi__poz--zapas{% endif %}">
      <a class="sasiedzi__kafel" href="{{ p.url }}" aria-label="{{ p.title | escape }}" title="{{ p.title | escape }}">
        <span class="sasiedzi__fot">
          {%- if p.featured_media -%}
            {{
              p.featured_media
              | image_url: width: 260
              | image_tag: loading: 'eager', fetchpriority: 'low', widths: '130, 200, 260', alt: ''
            }}
          {%- endif -%}
        </span>
        <span class="sasiedzi__cena">{{ p.price_min | money }}</span>
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if col and ile > 0 -%}
  <div
    class="spacing-style sasiedzi-sekcja"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="sasiedzi">
      <p class="sasiedzi__tytul">{{ section.settings.heading_prefix }} {{ col.title }}</p>
      <div class="sasiedzi__okno" id="Sasiedzi-{{ section.id }}" data-przerwa="{{ section.settings.interval }}">
        <ul class="sasiedzi__lista">{{ kafelki }}</ul>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var okno = document.getElementById('Sasiedzi-{{ section.id }}');
      if (!okno) return;

      var lista = okno.querySelector('.sasiedzi__lista');
      if (!lista) return;

      // Przy wyłączonych animacjach pasek zostaje nieruchomy.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var przerwa = (parseFloat(okno.dataset.przerwa) || 3) * 1000;
      var przygaszenie = 260;
      var mysz = window.matchMedia('(hover: hover)');
      var wskaznik = 0;
      var wskaznikPuli = 0;
      var ostatniRuch = 0;
      var poprzedni = null;
      var timer;

      okno.addEventListener(
        'scroll',
        function () {
          ostatniRuch = Date.now();
        },
        { passive: true }
      );

      // Trzy kubełki: co widać w całości, co jest w rzędzie ale poza kadrem,
      // i co czeka w zapasie. Kafelek wchodzący do kadru bierzemy z zapasu,
      // a gdy zapas jest pusty (kolekcja nie ma więcej produktów, niż pasek
      // już pokazuje) - z kafelka poza kadrem. Wtedy podmiana jest zamianą
      // miejscami: w kadrze widać nowy produkt, a ruch poza kadrem jest
      // niewidoczny i nic się nie dubluje.
      // Kafelki na styku krawędzi nie wpadają do żadnego kubełka - ani ich
      // nie podmieniamy, ani nimi nie podmieniamy.
      function podziel() {
        var lewa = okno.scrollLeft;
        var prawa = lewa + okno.clientWidth;
        var kubelki = { kadr: [], poza: [], zapas: [] };
        Array.prototype.forEach.call(lista.children, function (li) {
          if (li.classList.contains('sasiedzi__poz--zapas')) {
            kubelki.zapas.push(li);
            return;
          }
          var od = li.offsetLeft;
          var do_ = od + li.offsetWidth;
          if (od >= lewa - 1 && do_ <= prawa + 1) kubelki.kadr.push(li);
          else if (do_ <= lewa + 1 || od >= prawa - 1) kubelki.poza.push(li);
        });
        return kubelki;
      }

      // Zamiana miejscami dwóch kafelków w rzędzie. Oba mają tę samą
      // szerokość, więc ani rząd, ani pozycja przewinięcia nie drgną.
      function zamien(a, b) {
        var znacznik = document.createComment('');
        lista.insertBefore(znacznik, b);
        lista.insertBefore(b, a);
        lista.insertBefore(a, znacznik);
        lista.removeChild(znacznik);
      }

      function tyk() {
        // Sekcja przeładowana w edytorze motywu - stary licznik gasi się sam.
        if (!document.contains(okno)) {
          clearInterval(timer);
          return;
        }
        if (document.hidden) return;
        if (mysz.matches && okno.matches(':hover')) return;
        if (okno.contains(document.activeElement)) return;
        if (Date.now() - ostatniRuch < 1000) return;

        var kubelki = podziel();
        if (!kubelki.kadr.length) return;

        var zZapasu = kubelki.zapas.length > 0;
        var pula = zZapasu
          ? kubelki.zapas
          : kubelki.poza.filter(function (li) {
              // Kafelek zdjęty poprzednio pomijamy, żeby ten sam produkt nie
              // wracał do kadru w następnym tyknięciu.
              return li !== poprzedni;
            });
        if (!pula.length) return;

        var stary = kubelki.kadr[wskaznik % kubelki.kadr.length];
        var nowy = zZapasu ? pula[0] : pula[wskaznikPuli % pula.length];
        wskaznik += 1;
        wskaznikPuli += 1;

        stary.classList.add('sasiedzi__poz--gasnie');
        setTimeout(function () {
          nowy.classList.add('sasiedzi__poz--gasnie');

          if (zZapasu) {
            // Nowy wchodzi na miejsce starego, stary na koniec kolejki zapasu,
            // więc ten sam produkt wraca najwcześniej po tylu podmianach,
            // ile sztuk ma zapas.
            lista.insertBefore(nowy, stary);
            nowy.classList.remove('sasiedzi__poz--zapas');
            lista.appendChild(stary);
            stary.classList.add('sasiedzi__poz--zapas');
          } else {
            zamien(stary, nowy);
          }

          stary.classList.remove('sasiedzi__poz--gasnie');
          poprzedni = stary;

          // Dwie klatki: pierwsza maluje nowy kafelek jeszcze przezroczysty,
          // druga uruchamia przejście. Bez tego przeglądarka scala obie zmiany
          // w jedną klatkę i kafelek wskakuje bez przejścia.
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              nowy.classList.remove('sasiedzi__poz--gasnie');
            });
          });
        }, przygaszenie);
      }

      timer = setInterval(tyk, przerwa);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* Nie używam klasy section--page-width, bo base.css ma na nią globalne
     grid-template-columns: 1fr !important, a szerokość kontenera hero jest tam
     wpisana twardo pod konkretne ID sekcji. Powtarzam więc te same wymiary
     u siebie: 1540 max, 40 px na boki - to daje tę samą krawędź co zdjęcie. */
  .sasiedzi-sekcja {
    max-width: 1540px;
    margin-inline: auto;
    padding-inline: 40px;
  }

  /* Kolumna zdjęcia to połowa szerokości hero (siatka 680 + 680), ale samo
     zdjęcie jest o 24 px węższe - tyle wynosi padding-inline-end kolumny media,
     czyli połowa odstępu 48 px ustawionego w sekcji product-information.
     Odejmujemy go, żeby karuzela kończyła się równo ze zdjęciem. */
  .sasiedzi {
    max-width: calc(50% - 24px);
    min-width: 0;
  }

  @media screen and (width < 750px) {
    .sasiedzi-sekcja {
      padding-inline: 20px;
    }

    .sasiedzi {
      max-width: none;
    }
  }

  .sasiedzi__tytul {
    margin: 0 0 6px;
    font-size: 13px;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background));
  }

  /* Pasek pojawia się chwilę po wejściu na stronę, już z wczytanymi kafelkami.
     Bez tego widać było, jak obrazki wskakują jeden po drugim w ruchu. */
  .sasiedzi {
    opacity: 0;
    animation: sasiedzi-wejscie 420ms cubic-bezier(0.16, 1, 0.3, 1) 450ms forwards;
  }

  @keyframes sasiedzi-wejscie {
    to {
      opacity: 1;
    }
  }

  /* Pasek przewija się w bok: palcem na telefonie, gestem w bok albo
     shift+kółkiem na desktopie. Paska przewijania nie pokazujemy - na Windowsie
     zabrałby ~15 px wysokości, a od wysokości tego paska zależy wyrównanie
     prawej kolumny karty produktu (wyliczenie niżej). Że pasek idzie dalej,
     podpowiada maska wyciemniająca krawędzie.

     container-type pozwala liczyć szerokość kafelka od szerokości okna,
     a nie od listy, która jest celowo szersza niż ekran. */
  .sasiedzi__okno {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    container-type: inline-size;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
  }

  .sasiedzi__okno::-webkit-scrollbar {
    display: none;
  }

  /* Zawsze dokładnie pięć kafelków w kadrze: 5 * kafelek + 4 * 8 px odstępu = 100%.
     Jedna zmienna --kafel obsługuje i kafelki w rzędzie, i te z zapasu - zapas
     musi mieć tę samą szerokość, żeby przeglądarka wybrała z srcset ten sam
     plik i po podmianie nie dociągała obrazka od nowa.
     position: relative, bo od listy liczymy w JS offsetLeft kafelków. */
  .sasiedzi__lista {
    --kafel: calc((100cqw - 32px) / 5);
    position: relative;
    display: flex;
    width: max-content;
    gap: 8px;
    margin: 0;
    padding: 0 8px 0 0;
    list-style: none;
  }

  .sasiedzi__poz {
    flex: 0 0 var(--kafel);
    transition: opacity 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Zapas: kafelki gotowe do wejścia na pasek. Wyjęte z układu (position)
     i schowane przez visibility, nie display: none - obrazek ma być wczytany,
     zanim kafelek wejdzie w kadr. visibility zabiera je też z kolejności
     tabulacji i z drzewa dostępności, więc czytnik czyta produkty raz. */
  .sasiedzi__poz--zapas {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: var(--kafel);
    visibility: hidden;
  }

  .sasiedzi__poz--gasnie {
    opacity: 0;
  }

  .sasiedzi__kafel {
    display: grid;
    gap: 5px;
    justify-items: center;
    text-decoration: none;
  }

  .sasiedzi__fot {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 420ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sasiedzi__fot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sasiedzi__kafel:hover .sasiedzi__fot {
    border-color: var(--color-primary);
    box-shadow: 0 8px 18px -10px color-mix(in srgb, var(--color-primary) 60%, transparent);
  }

  .sasiedzi__kafel:hover .sasiedzi__fot img {
    transform: scale(1.07);
  }

  .sasiedzi__cena {
    font-size: 12px;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-foreground) 72%, var(--color-background));
  }

  /* Bez ruchu: żadnych podmian (JS sam się nie uruchamia), pasek bez maski
     i bez pojawiania się, kafelki w stałych 76 px - zostaje zwykły rząd
     do przewinięcia palcem. */
  @media (prefers-reduced-motion: reduce) {
    .sasiedzi__okno {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .sasiedzi__lista {
      --kafel: 76px;
    }

    .sasiedzi {
      opacity: 1;
      animation: none;
    }
  }

  /* Okruszki renderuje layout, nie sekcja, więc stroimy je tylko na stronach,
     na których ta sekcja faktycznie jest. Domyślnie wiszą po prawej w węższym
     kontenerze niż treść i trzymają 16 px odstępu u góry i u dołu - przez to
     na karcie produktu wyglądają, jakby należały do czegoś innego.
     Tu: do lewej, w tej samej siatce co karuzela i zdjęcie, i ciaśniej. */
  body:has(.sasiedzi-sekcja) .breadcrumbs {
    justify-content: flex-start;
    padding: 4px 40px 10px;
    text-align: left;
  }

  /* Odstęp nad zdjęciem należy do wrappera sekcji hero i jest tam ustawiony
     z !important (.shopify-section[id$="__main"]:has(.product-information)).
     Przy karuzeli ten odstęp lądował POD nią zamiast pod okruszkami i robił
     80 px pustki. Przenosimy go nad pasek: sekcja hero dostaje wąski odstęp,
     a oddech daje padding-block-start samej karuzeli (ustawienie w schemacie).
     Selektor musi być bardziej szczegółowy od tamtej reguły, stąd !important. */
  .shopify-section:has(> .sasiedzi-sekcja) + .shopify-section[id$='__main'] {
    padding-block-start: 14px !important;
  }

  /* Prawa kolumna podnosi się o wysokość paska, żeby ocena i tytuł zaczynały
     się na tej samej wysokości co karuzela po lewej. Tylko desktop.

     Wysokość paska liczona, nie wpisana na sztywno: 70 px to stałe części
     (odstępy sekcji 16 + 14, etykieta 17 + 6, cena 12 + 5), a kafelek to
     (szerokość paska - 4 odstępy) / 5. Szerokość paska to szerokość kolumny
     zakupowej minus 24 px, stąd (100% - 56px) / 5 - procent w marginesie
     liczy się od szerokości kolumny. */
  @media screen and (width >= 750px) {
    .shopify-section:has(> .sasiedzi-sekcja) + .shopify-section[id$='__main'] .product-details {
      margin-block-start: calc(-1 * (70px + (100% - 56px) / 5));
    }

    /* Po podniesieniu prawa kolumna kończy się 48 px wyżej niż miniatury
       galerii po lewej. Rozkładamy te 48 px po równo na osiem przerw między
       blokami kolumny zakupowej: 24 px + 6 px = 30 px. Dolne krawędzie obu
       kolumn siadają równo, a odstępy rosną delikatnie i równomiernie.

       Uwaga: 6 px jest dobrane do tego produktu. Przy produkcie z inną liczbą
       wariantów luz będzie inny, więc przy rozszerzaniu na kolejne szablony
       trzeba to policzyć od nowa albo rozdzielać luz automatycznie.

       Selektor celuje wyłącznie w kontener najwyższego poziomu. Szerszy
       `.group-block-content` łapie też kontenery zagnieżdżone w blokach
       i odstęp rośnie dwa razy - sprawdzone, dawało 96 px zamiast 48. */
    .shopify-section:has(> .sasiedzi-sekcja) + .shopify-section[id$='__main']
      .product-details > .group-block > .group-block-content {
      row-gap: 30px;
    }
  }

  @media screen and (width < 750px) {
    body:has(.sasiedzi-sekcja) .breadcrumbs {
      padding: 4px 20px 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sąsiedzi z kolekcji",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekcja",
      "info": "Puste = pierwsza kolekcja produktu."
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Słowo przed nazwą kolekcji",
      "default": "More"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Ile produktów",
      "min": 6,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Co ile sekund zmienia się kafelek",
      "unit": "s",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Odstęp u góry",
      "unit": "px",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Odstęp u dołu",
      "unit": "px",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 14
    }
  ],
  "presets": [{ "name": "Sąsiedzi z kolekcji" }]
}
{% endschema %}
