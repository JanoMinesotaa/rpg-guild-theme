  <style>
    .bloggle_rte p:not(.bggle-font) {
      font-size: 14px;
      line-height: 1.6em;
    }
    .bloggle_rte a,.bloggle_rte li,.bloggle_rte ul,.bloggle_rte strong, .bloggle_rte span, .bloggle_rte ol {
      font-size: inherit;
      line-height: inherit;
    }
  </style>
  <script async src="https://d2xvgzwm836rzd.cloudfront.net/lazysizes-bloggle.min.js"></script>
  <link href="https://d2xvgzwm836rzd.cloudfront.net/article-layout.min.css" type="text/css" rel="stylesheet">
  <div id="bloggle_article-layout" class="sideBar__left{%if localization.language.iso_code == "ar" or localization.language.iso_code == "he" %} blggle-rtl{%endif%}">
  <div id="bloggle_article" >
      <div id="article" class="flex-column">
      {% if article.image %}
      <img class="bloggle--blog-item-img lazybloggle" data-src="{{ article.image | img_url:'1200x' }}" alt="{{ article.image.alt }}">
      {% endif %}
    <div id="article-header" class="text__center">
      
       <div class="tags">
        {% for tag in article.tags %}
<a href="{{ blog.url }}/tagged/{{ tag | handle }}" id='bloggle--blog-item-tags'>{{ tag }}</a>
 {% endfor %}
</div>
      <h1 id="bloggle--article-title" class="image-with-text__heading h1">{{article.title }}</h1>
      <div class="info_header">
        <p id="bloggle--blog-item-author" >{{author}}<span id="author"> {{ article.author }}</span></p>
        <p id="separator">|</p>
         <p id="bloggle--blog-item-author" >{{datePublished}} <span>{{ article.published_at | time_tag: format: 'date'}}</span></p>
          
           
        <p id="separator">|</p>
        {% assign wordCount = article.content | strip_html | split: ' ' | size %}
               {% if wordCount %}
                 {% assign timeToReadMin = wordCount | divided_by: 225 %}
                 <p id="bloggle--blog-item-ttread" >{{ timeToRead }} <span id='time'>{{ timeToReadMin }}</span> min</p>
               {% endif %}
      </div>
    </div>
  </div>
    <div class="bloggle_rte rte" id="bloggle_rte">
      {{ article.content }}
    <div id="bloggle--blog-item-goback" class="bloggle--goback-bottom">
         <a href="{{blog.url}}">&#8592 {{goback}}</a>
      </div>
    </div>

    
  </div>

  
  </div>

{% if article.comments_enabled? %}
  <div id="bloggle-template__comment-wrapper">
      <div id="bloggle_comment-layout">
        {% if article.comments_count > 0 %}
          <span id="comments"></span>
          <p id="bggle--comments-{{ article.id }}" style="font-size: 20px;">{{commentsListTitle}}</p>
          {% paginate article.comments by 5 %}
            <div>
              {% if comment.status == 'pending' and comment.content %}
                <article id="{{ comment.id }}">
                  {{ comment.content }}
                  <footer style="text-align: right;">
                    <span class="bggle--author">{{ comment.author }}</span>
                  </footer>
                </article>
              {% endif %}

              {% for comment in article.comments %}
                <article id="{{ comment.id }}">
                  {{ comment.content }}
                  <footer style="text-align: right;">
                    <span class="bggle--author">{{ comment.author }}</span><span style="margin-left: 10px;">{{ comment.created_at | time_tag: format: 'date' }}</span>
                  </footer>
                </article>
              {% endfor %}
              {% if paginate.parts.size > 0 %}
                <span id="pagination-anchor"></span>
                <div class="bggle--pagination-container">
                  {% if paginate.previous %}
                    <a class="bggle--pagination-item bggle--pagination-item-arrow" href="{{ paginate.previous.url }}#pagination-anchor" >
                      <svg class="bggle--icon" role="presentation" viewBox="0 0 11 21">
                        <polyline fill="none" stroke="currentColor" points="10.5 0.5 0.5 10.5 10.5 20.5" stroke-width="1.25"></polyline>
                      </svg>
                    </a>
                  {% endif %}
                  {% for part in paginate.parts %}
                    {% if part.is_link %}
                      <a class="bggle--pagination-item" href="{{ part.url }}#pagination-anchor" >{{ part.title }}</a>
                    {% else %}
                      {% if part.title == paginate.current_page %}
                        <a class="bggle--pagination-item" >{{ part.title }}</a>
                      {%  else %}
                        <span class="bggle--pagination-item">{{ part.title }}</span>
                      {%  endif %}
                    {% endif %}
                  {% endfor %}

                  {% if paginate.next %}
                    <a class="bggle--pagination-item bggle--pagination-item-arrow" href="{{ paginate.next.url }}#pagination-anchor" >
                      <svg class="bggle--icon" role="presentation" viewBox="0 0 11 21">
                        <polyline fill="none" stroke="currentColor" points="0.5 0.5 10.5 10.5 0.5 20.5" stroke-width="1.25"></polyline>
                      </svg>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endpaginate %}
        {% endif %}

        <span id="comments"></span>
        {% form 'new_comment', article %}
          <p style="font-size: 20px;">{{commentsTitle}}</p>

          {% if form.errors %}
            <p class="bggle--form-error">{{commentErrorMessage}}</p>
          {% elsif form.posted_successfully? %}
            <p class="bggle--success-message">{{commentSuccessMessage}}</p>
          {% endif %}

          <div{% if blog.moderated? == false %} class="article-template__comments-fields"{% endif %}>
            <div>
              <div class="bggle--field">
                <label for="bggle-comment-name">{{commentNameLabel}} *</label>
                <input
                  type="text"
                  class="bggle--input"
                  name="comment[author]"
                  id="bggle-comment-name"
                  value="{{ form.author }}"
                  required
                  placeholder="{{commentNamePlaceholder}}"
                >
                {% if form.errors contains 'author' %}
                  <p class="bggle--form-error">{{commentNameError}}</p>
                {% endif %}
              </div>
              <div class="bggle--field">
                <label for="bggle-comment-email">{{commentEmailLabel}} *</label>
                <input
                  class="bggle--input"
                  type="email"
                  name="comment[email]"
                  id="bggle-comment-email"
                  autocomplete="email"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  placeholder="{{commentEmailPlaceholder}}"
                >
                {% if form.errors contains 'email' %}
                  <p class="bggle--form-error">{{commentEmailError}}</p>
                {% endif %}
              </div>
            </div>
            <div class="bggle--field">
              <label class="bggle--label" for="bggle-comment-body">{{commentMessageLabel}} *</label>
              <textarea
                class="bggle--input bggle--textarea"
                rows="5"
                name="comment[body]"
                id="bggle-comment-body"
                required
                placeholder="{{commentMessagePlaceholder}}"
              >{{ form.body }}</textarea>
            </div>
            {% if form.errors contains 'body' %}
              <p class="bggle--form-error">{{commentMessageError}}</p>
            {% endif %}
          </div>
          <button type="submit" style="border: none;" class="button button--primary" >{{commentButton}}</button>
        {% endform %}
      </div>
    </div>
{% endif %}


  <style>
